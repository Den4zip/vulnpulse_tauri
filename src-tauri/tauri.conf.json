{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VulnPulse",
  "version": "0.1.0",
  "identifier": "ru.vulnpulse.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "VulnPulse", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 600 }], "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'" } },
  "bundle": { "active": false }
}
